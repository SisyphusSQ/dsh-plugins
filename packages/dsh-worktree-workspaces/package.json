{
  "name": "dsh-worktree-workspaces",
  "version": "0.1.0",
  "description": "Git worktree creation, archival, and Web slash-command picker for DeepSeek Harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SisyphusSQ/dsh-plugins.git",
    "directory": "packages/dsh-worktree-workspaces"
  },
  "homepage": "https://github.com/SisyphusSQ/dsh-plugins/tree/main/packages/dsh-worktree-workspaces#readme",
  "bugs": {
    "url": "https://github.com/SisyphusSQ/dsh-plugins/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "git",
    "worktree"
  ],
  "type": "module",
  "main": "lib/src/index.js",
  "types": "lib/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/index.d.ts",
      "default": "./lib/src/index.js"
    },
    "./client": {
      "types": "./lib/src/client.d.ts",
      "default": "./lib/client.js"
    },
    "./protocol": {
      "types": "./lib/src/protocol.d.ts",
      "default": "./lib/src/protocol.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-worktree": "lib/src/cli.js"
  },
  "files": [
    "lib/src",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "screenshots",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsdown && pnpm run chmod-bin",
    "chmod-bin": "node -e \"require('node:fs').chmodSync('lib/src/cli.js', 0o755)\"",
    "prepack": "pnpm run build",
    "test": "pnpm run build && node --test lib/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-commands": "0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "tsdown": "^0.15.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
