{
  "name": "dsh-git-worktree-web",
  "version": "0.1.0",
  "description": "Web slash-command picker for dsh-git-worktree",
  "type": "module",
  "main": "lib/src/client.js",
  "types": "lib/src/client.d.ts",
  "exports": {
    ".": {
      "types": "./lib/src/client.d.ts",
      "default": "./lib/src/client.js"
    },
    "./client": {
      "types": "./lib/src/client.d.ts",
      "default": "./lib/src/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "pnpm run build && node --test lib/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-commands"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.0-rc.6",
    "dsh-git-worktree": "0.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-api-remotes": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-commands": "0.1.0-rc.6",
    "@types/node": "^24.0.0",
    "dsh-git-worktree": "workspace:*",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
